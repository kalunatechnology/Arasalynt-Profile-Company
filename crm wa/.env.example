# ── Server Configuration ───────────────────────────────────────────────
PORT=3005
NODE_ENV=production

# ── Security & Authentication Secret (Opsional namun disarankan) ───────
GATEWAY_SECRET=arsalynt-wa-secret-2026
ALLOWED_ORIGINS=*

# ── Next.js Webhook Integration ────────────────────────────────────────
NEXTJS_WEBHOOK_URL=http://localhost:3000/api/whatsapp/webhook

# ── Auth Storage & Serverless Persistence ──────────────────────────────
# Direktori penyimpanan kredensial (default: ./auth_info_baileys atau /tmp di Serverless)
AUTH_DIR=

# Base64 Exported Session untuk Serverless (Vercel / AWS Lambda)
# Dapatkan dari tombol 'Export Session' di Dashboard Gateway
WA_SESSION_BASE64=
