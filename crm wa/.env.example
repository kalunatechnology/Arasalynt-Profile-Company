# ── Server Configuration ───────────────────────────────────────────────
PORT=3005
NODE_ENV=production

# ── Security & Authentication Secret (Opsional namun disarankan) ───────
GATEWAY_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=*

# ── Next.js Webhook Integration ────────────────────────────────────────
NEXTJS_WEBHOOK_URL=https://www.arsalynk.com/api/whatsapp/webhook

# ── Auth Storage & Session Persistence ─────────────────────────────────
# Direktori penyimpanan kredensial (default: ./auth_info_baileys atau /tmp di Serverless)
AUTH_DIR=

# Base64 Exported Session terutama untuk Serverless (Vercel / AWS Lambda).
# Pada Hostinger/VPS stateful, nilai ini diabaikan secara default agar bundle lama
# tidak terus merestore sesi rusak setiap kali proses restart.
WA_SESSION_BASE64=

# Khusus jika pada Hostinger/VPS Anda memang sengaja ingin restore dari ENV.
RESTORE_SESSION_FROM_ENV=false

# Recovery one-time untuk sesi lokal yang stale/rusak.
# Set true untuk SATU deployment agar auth lama dihapus dan QR baru dibuat.
# Setelah berhasil scan QR, ubah kembali ke false.
WA_FORCE_FRESH_SESSION=false

# Diagnostic startup log delay (ms)
WA_STARTUP_DIAGNOSTIC_DELAY_MS=15000

# ── Optional Chatbot WhatsApp Auto Reply ───────────────────────────────
# Fitur tambahan. Default false agar flow WhatsApp/Webhook existing tidak berubah.
CHATBOT_AUTO_REPLY_ENABLED=false

# Full endpoint Chatbot_Arsalynk
CHATBOT_API_URL=http://localhost:5000/api/v1/chat/completions

# Enterprise tenant credential (jangan commit secret asli)
CHATBOT_TENANT_API_KEY=
CHATBOT_TENANT_EXTERNAL_ID=
CHATBOT_INBOUND_CONTEXT_KEY=

# Batasi customer WhatsApp ke scope publik/customer.
CHATBOT_ENABLED_MODULES=GENERAL
CHATBOT_ROLE_CODES=CUSTOMER
CHATBOT_LOCALE=id-ID

# Timeout request chatbot (ms)
CHATBOT_TIMEOUT_MS=70000

# ── Reliable Message Store ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECT_TIMEOUT_MS=10000
# Set true after production MySQL env has been verified.
WA_REQUIRE_MYSQL=false
SQLITE_DB_PATH=

# ── Routing ────────────────────────────────────────────────────────────
ROUTING_MODE=TEST
WA_SALES_PHONE=
WA_FINANCE_PHONE=
WA_TECHNICAL_PHONE=
WA_PROJECT_PHONE=
WA_GENERAL_PHONE=
