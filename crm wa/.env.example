# ============================================================
# ARSALYNT WHATSAPP GATEWAY - ENVIRONMENT TEMPLATE
# ============================================================
# Salin file ini menjadi '.env' dan sesuaikan nilainya:
# cp .env.example .env

# 1. MODE & PORT SERVER
NODE_ENV=production
PORT=3005

# 2. KEAMANAN & API KEY
# Kunci rahasia untuk otorisasi API & verifikasi webhook.
# Nilai ini harus sama persis antara Gateway dan Next.js.
GATEWAY_SECRET=ganti_dengan_kunci_rahasia_anda_yang_kuat

# Daftar domain yang diizinkan memanggil API gateway dari browser (CORS).
# Contoh: ALLOWED_ORIGINS=https://app.arsalynt.com,https://arsalynt.com
ALLOWED_ORIGINS=*

# 3. WEBHOOK MENUJU NEXT.JS
# Alamat webhook Next.js untuk menerima pesan masuk dari WhatsApp.
# Di production, ganti dengan domain publik website Anda.
NEXTJS_WEBHOOK_URL=https://app.arsalynt.com/api/whatsapp/webhook

# 4. PENYIMPANAN SESI WHATSAPP (OPSIONAL)
# Lokasi folder sesi login (default: ./auth_info_baileys). Kosongkan jika pakai default.
AUTH_DIR=

# Hanya untuk serverless (Vercel / AWS Lambda). Kosongkan jika pakai VPS/Docker.
WA_SESSION_BASE64=
