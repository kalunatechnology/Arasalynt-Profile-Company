# ============================================================
# Arsalynk Website — Production Environment Contract
# ============================================================

# ------------------------------------------------------------
# Chatbot_Arsalynk Enterprise Tenant Integration
# Secrets below are SERVER-ONLY. Never prefix them with NEXT_PUBLIC_.
# ------------------------------------------------------------
CHATBOT_API_BASE_URL=https://chatbot-arsalynk.vercel.app
CHATBOT_TENANT_API_KEY=<raw tenant bearer key from tenant provision/rotation>
CHATBOT_TENANT_EXTERNAL_ID=SINERGI_MUDA_ARSA
CHATBOT_INBOUND_CONTEXT_KEY=<active inbound context HMAC key>
CHATBOT_COMPANY_ID=SINERGI_MUDA_ARSA
CHATBOT_ENABLED_MODULES=GENERAL
CHATBOT_ROLE_CODES=CUSTOMER
CHATBOT_PERMISSIONS=
CHATBOT_PROJECT_SCOPE_MODE=LIST
CHATBOT_PROJECT_IDS=
CHATBOT_LOCALE=id-ID
CHATBOT_TIMEOUT_MS=70000
CHATBOT_AUTO_REPLY_ENABLED=true

# CHATBOT_API_URL is accepted for compatibility with the current Chatbot
# Admin export. CHATBOT_API_BASE_URL is preferred. If CHATBOT_API_URL contains
# /api/v1/chat/completions the website normalizes it back to the base URL.
# CHATBOT_API_URL=https://chatbot-arsalynk.vercel.app/api/v1/chat/completions

# ------------------------------------------------------------
# Meta WhatsApp Cloud API
# ------------------------------------------------------------
BAYPASS=false
WHATSAPP_CLOUD_API_VERSION=v25.0
WHATSAPP_CLOUD_PHONE_NUMBER_ID=<meta phone number id>
WHATSAPP_CLOUD_ACCESS_TOKEN=<permanent/system-user access token>
WHATSAPP_CLOUD_CS_PHONE=<destination number in international format>
WHATSAPP_CLOUD_VERIFY_TOKEN=<custom webhook verify token>
WHATSAPP_CLOUD_APP_SECRET=<Meta App Settings > Basic > App Secret>

# Optional App Secret aliases / rotation grace
# META_APP_SECRET=
# FACEBOOK_APP_SECRET=
# WHATSAPP_CLOUD_APP_SECRET_PREVIOUS=

# ------------------------------------------------------------
# Legacy variables — do NOT use for the public ArsAI flow
# ------------------------------------------------------------
# NEXT_PUBLIC_CHATBOT_CALLER_TOKEN=
# CHATBOT_CALLER_TOKEN=
